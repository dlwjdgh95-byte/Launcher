<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Black window so nothing flashes white before Compose draws; bar colors are set by enableEdgeToEdge(). -->
    <style name="Theme.MonoLauncher" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:colorAccent">@android:color/white</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
