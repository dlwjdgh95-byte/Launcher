# nas-relay 설정 예시 — `cp .env.example .env` 후 본인 값으로 바꾼다.
# .env는 git에 올리지 않는다(.gitignore 처리됨). 값은 따옴표 없이 쓰되,
# 공백이 있는 값(SHUTDOWN_CMD)만 작은따옴표로 감싼다. 주석은 항상 별도 줄에 쓴다.

# [필수] 베어러 토큰. 32바이트 난수로 만든다:  openssl rand -hex 32
# 예시 값(change-me...)은 그대로 쓰면 서버가 시작을 거부한다.
RELAY_TOKEN=change-me-32-bytes-hex

# 서버가 듣는 주소. NAS의 Tailscale IP(100.x.x.x, `tailscale ip -4`)로 바꾼다.
# 0.0.0.0은 모든 인터페이스에 열리므로 쓰지 않는다. 기본값은 127.0.0.1(자기 자신만).
RELAY_BIND=100.101.102.103

# 서버 포트. 기본 8585
RELAY_PORT=8585

# [필수] 깨울 PC의 랜카드 MAC 주소. AA:BB:CC:DD:EE:FF / AA-BB-... / aabbccddeeff 모두 가능
PC_MAC=AA:BB:CC:DD:EE:FF

# 매직패킷을 보낼 브로드캐스트 주소. 기본 255.255.255.255
# 안 깨어나면 LAN 전용 브로드캐스트(예: 192.168.0.255)로 바꿔 본다.
WOL_BROADCAST=255.255.255.255

# 매직패킷 UDP 포트. 기본 9 (7도 흔함)
WOL_PORT=9

# 패킷 전송 횟수. 기본 3 (1~20)
WOL_REPEAT=3

# 상태 확인(/status) 대상 PC. PC의 Tailscale IP 또는 LAN IP. 비우면 /status가 400을 돌려준다.
PC_HOST=100.100.100.100

# Sunshine HTTP 포트. /status가 이 포트로 TCP 연결을 시도한다. 기본 47989
SUNSHINE_PORT=47989

# 요청을 받아 줄 클라이언트 IP 대역(쉼표 구분). 그 밖은 403.
# 기본값은 Tailscale(100.64.0.0/10)과 루프백. 전체 허용(0.0.0.0/0)은 권하지 않는다.
ALLOW_CIDRS=100.64.0.0/10,127.0.0.0/8

# [선택] /shutdown이 실행할 셸 명령(20초 제한). 비워 두면 /shutdown은 501.
# 예: Windows OpenSSH 서버에 키로 접속해 종료. Docker 이미지에는 ssh가 없으니 Dockerfile 주석 참고.
# SHUTDOWN_CMD='ssh -i /keys/pc_ed25519 -o BatchMode=yes user@100.100.100.100 shutdown /s /t 0'
